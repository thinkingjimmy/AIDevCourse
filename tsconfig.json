{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@source": [
        "./.source/server.ts",
        "./.source-test/server.ts"
      ],
      "@catalog": [
        "./.source/catalog.json",
        "./.source-test/catalog.json"
      ],
      "@routes": [
        "./.source/routes.json",
        "./.source-test/routes.json"
      ],
      "@catalog-reader": [
        "./src/lib/content/source/production.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "config/**/*.ts",
    ".source/**/*.ts",
    ".source-test/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-test/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/anatomy"
  ]
}
