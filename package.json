{
  "name": "aidevcourse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.17.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "content:generate": "node scripts/generate-content.mjs",
    "content:check": "node --import tsx scripts/check-content.ts",
    "i18n:check": "node --import tsx scripts/check-i18n.ts",
    "lint": "eslint --config config/eslint.config.mjs src scripts tests config next.config.mjs",
    "typecheck": "pnpm content:generate && tsc --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "build": "pnpm content:check && pnpm i18n:check && next build",
    "start": "next start",
    "check": "pnpm structure:check && pnpm lint && pnpm typecheck && pnpm content:check && pnpm i18n:check && pnpm test",
    "test:e2e:report": "playwright show-report .artifacts/e2e/public/report",
    "measure:performance": "node scripts/measure-performance.mjs",
    "structure:check": "node --import tsx scripts/check-structure.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource/geist-pixel": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fumadocs-core": "16.15.13",
    "fumadocs-mdx": "15.4.3",
    "fumadocs-ui": "16.15.13",
    "github-slugger": "2.0.0",
    "glisse": "0.5.0",
    "katex": "0.19.1",
    "mdast-util-to-string": "4.0.0",
    "next": "16.4.1",
    "next-intl": "4.14.6",
    "pele": "1.13.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-mark-highlight": "0.1.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwind-merge": "3.7.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zbsearch": "4.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.1",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "katex": "0.19.1",
      "vite": "8.3.3"
    }
  },
  "description": "A multilingual learning site for local Markdown and MDX courses.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkingjimmy/aidevcourse.git"
  },
  "bugs": {
    "url": "https://github.com/thinkingjimmy/aidevcourse/issues"
  }
}
