{
  "name": "@local/dsh-tutorial-review",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Tutorial writing assistant with read-only review, margin annotations, AI polish/expansion, and link suggestions.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "annotations/**/*.json",
    "annotations/SCHEMA.md",
    "README.md",
    "external-sources.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build-css.mjs && ../../node_modules/.bin/esbuild src/loader.js --bundle --format=iife --platform=browser --target=es2022 --outfile=client.js --log-level=warning"
  }
}
