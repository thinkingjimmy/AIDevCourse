# Copy this file to .env.local for local development.
SITE_URL=http://localhost:3000

# Vercel Production: set SITE_URL to your verified HTTPS origin.
# Vercel Preview: leave SITE_URL unset; VERCEL_URL supplies the preview origin.
# Enable System Environment Variables in Vercel project settings.
# Set ENABLE_EXPERIMENTAL_COREPACK=1 in Vercel to use the pinned pnpm version.
# Never set CONTENT_TEST in a Vercel environment.
